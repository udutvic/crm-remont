{
  "name": "crm-remont-backend",
  "version": "1.0.0",
  "description": "Backend for CRM Remont project using Node.js, Express, Sequelize, PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "sequelize": "sequelize-cli",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "audit": "npm audit --omit=dev",
    "audit:fix": "npm audit fix --omit=dev",
    "db:backup": "node src/scripts/backupDatabase.js",
    "db:inspect": "node src/scripts/inspectDatabase.js",
    "auth:create-user": "node src/scripts/createUser.js"
  },
  "dependencies": {
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.111.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "multer": "^2.2.0",
    "pg": "^8.15.6",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.5"
  }
}
